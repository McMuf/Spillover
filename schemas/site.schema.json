    "Claim": {
      "additionalProperties": false,
      "properties": {
        "baseline": {
          "default": "factor_only",
          "enum": [
            "factor_only",
            "constant_mean"
          ],
          "title": "Baseline",
          "type": "string"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 0.99,
              "minimum": 0.5,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "decompose": {
          "items": {
            "enum": [
              "mechanical_weight",
              "spillover"
            ],
            "type": "string"
          },
          "title": "Decompose",
          "type": "array"
        },
        "event_type": {
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "title": "Event Type",
          "type": "string"
        },
        "expected_sign": {
          "enum": [
            "positive",
            "negative"
          ],
          "title": "Expected Sign",
          "type": "string"
        },
        "factor": {
          "default": "MKT",
          "minLength": 1,
          "title": "Factor",
          "type": "string"
        },
        "falsifier": {
          "minLength": 10,
          "title": "Falsifier",
          "type": "string"
        },
        "id": {
          "pattern": "^clm_[a-z0-9]+(?:_[a-z0-9]+)*_v[0-9]+$",
          "title": "Id",
          "type": "string"
        },
        "instrument": {
          "$ref": "#/$defs/Instrument"
        },
        "measure": {
          "default": "abnormal_return",
          "enum": [
            "abnormal_return",
            "abs_excess_return"
          ],
          "title": "Measure",
          "type": "string"
        },
        "registered_at": {
          "anyOf": [
            {
              "const": "set_by_ci_on_merge",
              "type": "string"
            },
            {
              "format": "date-time",
              "type": "string"
            }
          ],
          "title": "Registered At"
        },
        "registered_by": {
          "minLength": 1,
          "title": "Registered By",
          "type": "string"
        },
        "statement": {
          "minLength": 10,
          "title": "Statement",
          "type": "string"
        },
        "success": {
          "$ref": "#/$defs/Success"
        },
        "trigger_entities": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Trigger Entities",
          "type": "array"
        },
        "window": {
          "$ref": "#/$defs/Window"
        }
      },
      "required": [
        "id",
        "statement",
        "event_type",
        "trigger_entities",
        "instrument",
        "window",
        "expected_sign",
        "decompose",
        "baseline",
        "factor",
        "measure",
        "confidence",
        "success",
        "falsifier",
        "registered_by",
        "registered_at"
      ],
      "title": "Claim",
      "type": "object"
    },
